<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KYC - EduPay</title>
  <%- include('../partials/head') %>
</head>
<body class="bg-surface font-body-md text-on-surface flex flex-col min-h-screen">
  <%- include('../partials/nav', { user, unreadCount }) %>

  <main class="flex-grow max-w-2xl mx-auto px-gutter py-8 w-full space-y-6">
    <div class="bg-white border border-outline-variant rounded-xl shadow-sm p-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="material-symbols-outlined text-primary text-[28px]">verified_user</span>
        <h1 class="font-headline-lg text-headline-lg text-primary">Identity verification</h1>
      </div>
      <p class="font-body-md text-body-md text-slate-muted mb-6">Submit a document so EduPay can verify your identity before you make payments.</p>

      <% if (error) { %><div class="mb-5 px-4 py-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm"><%= error %></div><% } %>
      <% if (success) { %><div class="mb-5 px-4 py-3 rounded-lg bg-status-completed/10 text-status-completed font-body-sm text-body-sm"><%= success %></div><% } %>

      <form action="/kyc" enctype="multipart/form-data" method="POST" class="space-y-5">
        <div>
          <label class="block font-label-md text-label-md text-slate-muted uppercase tracking-wider mb-2" for="documentType">Document type</label>
          <select class="w-full px-4 py-2.5 rounded-lg border border-outline-variant bg-white focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-body-md text-body-md text-on-surface" id="documentType" name="documentType" required>
            <option value="PASSPORT">Passport</option>
            <option value="NATIONAL_ID">National ID</option>
            <option value="STUDENT_ID">Student ID</option>
            <option value="PROOF_OF_ADDRESS">Proof of address</option>
          </select>
        </div>
        <div>
          <label class="block font-label-md text-label-md text-slate-muted uppercase tracking-wider mb-2" for="file">Document file</label>
          <div class="flex items-center justify-center w-full px-6 py-8 rounded-xl border-2 border-dashed border-outline-variant bg-surface-container-low hover:border-primary transition-colors">
            <div class="text-center">
              <span class="material-symbols-outlined text-slate-muted text-[32px] mb-1">upload_file</span>
              <p class="font-body-sm text-body-sm text-slate-muted">JPEG, PNG, or PDF, up to 5MB</p>
              <input accept="image/jpeg,image/png,application/pdf" class="mt-3 w-full text-body-sm font-body-sm file:mr-3 file:px-4 file:py-2 file:rounded-lg file:border-0 file:bg-primary file:text-white file:font-label-md file:text-label-md file:cursor-pointer" id="file" name="file" required type="file" />
            </div>
          </div>
        </div>

        <button class="w-full py-3 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:opacity-90 active:scale-95 transition-all" type="submit">Submit for review</button>
      </form>
    </div>

    <div class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-outline-variant bg-surface-container-low">
        <h2 class="font-headline-md text-headline-md text-primary">Your submissions</h2>
      </div>
      <% if (status.documents.length === 0) { %>
        <p class="p-6 font-body-md text-body-md text-slate-muted">No documents submitted yet.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container-low border-b border-outline-variant">
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">Submitted</th>
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">File</th>
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">Reviewer note</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
              <% status.documents.forEach(function (doc) { %>
                <tr class="hover:bg-surface-container-low transition-colors">
                  <td class="px-6 py-4 font-body-md text-on-surface"><%= doc.documentType %></td>
                  <td class="px-6 py-4"><%- include('../partials/badge', { status: doc.status }) %></td>
                  <td class="px-6 py-4 font-body-sm text-body-sm text-slate-muted"><%= new Date(doc.submittedAt).toLocaleDateString() %></td>
                  <td class="px-6 py-4">
                    <a class="text-primary hover:underline font-label-md text-label-md inline-flex items-center gap-1" href="/kyc/<%= doc.id %>/file" rel="noopener noreferrer" target="_blank">
                      <span class="material-symbols-outlined text-[18px]">description</span>
                      <%= doc.originalFileName %>
                    </a>
                  </td>
                  <td class="px-6 py-4 font-body-sm text-body-sm text-slate-muted"><%= doc.reviewNote || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
