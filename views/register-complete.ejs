<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EduPay | Account Completion</title>
  <%- include('partials/head') %>
  <style>
    .glass-card {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .step-gradient {
      background: linear-gradient(90deg, #091426 0%, #5654a8 100%);
    }
  </style>
</head>
<body class="bg-background text-on-background font-body-md min-h-screen flex flex-col selection:bg-secondary-container">
  <header class="sticky top-0 z-50 flex justify-between items-center w-full px-gutter h-16 max-w-container-max mx-auto bg-surface-container-lowest shadow-sm">
    <a class="text-headline-md font-headline-md font-bold text-primary" href="/">EduPay</a>
    <nav class="flex items-center gap-6">
      <a class="hidden md:flex font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="/login">Already registered?</a>
    </nav>
  </header>

  <main class="flex-grow flex flex-col items-center justify-center py-12 px-4 md:px-gutter relative overflow-hidden">
    <div class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Progress and Branding -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <span class="font-label-md text-label-md text-secondary uppercase tracking-widest">Registration Flow</span>
          <h1 class="font-headline-lg text-headline-lg text-primary">Complete Your Secure Profile</h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant">We've verified your academic status. Now, let's finalize your account security and regional settings.</p>
        </div>

        <div class="flex flex-col gap-4 bg-surface-container p-6 rounded-xl border border-outline-variant">
          <div class="flex justify-between items-center">
            <span class="font-label-md text-label-md text-on-surface">Step 2 of 2</span>
            <span class="font-label-md text-label-md text-status-completed font-bold">90% Complete</span>
          </div>
          <div class="w-full h-2 bg-surface-variant rounded-full overflow-hidden">
            <div class="h-full step-gradient w-[90%] transition-all duration-1000 ease-out"></div>
          </div>
          <div class="flex flex-col gap-3 mt-2">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-status-completed text-[20px]">check_circle</span>
              <span class="font-body-sm text-body-sm text-on-surface">Identity Verification</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-[20px]">radio_button_checked</span>
              <span class="font-body-sm text-body-sm text-primary font-semibold">Account Completion</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: The Form -->
      <div class="lg:col-span-7 glass-card rounded-xl shadow-xl border border-white/60 p-8 flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2 pb-2 border-b border-outline-variant">
            <span class="material-symbols-outlined text-status-completed">verified</span>
            <h2 class="font-headline-md text-headline-md text-primary">Verified Credentials</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 bg-surface-container-low rounded-lg border border-outline-variant/30">
              <label class="font-label-md text-label-md text-slate-muted block mb-1">Full Name</label>
              <div class="font-body-md text-body-md text-primary font-semibold"><%= name %></div>
            </div>
            <div class="p-4 bg-surface-container-low rounded-lg border border-outline-variant/30">
              <label class="font-label-md text-label-md text-slate-muted block mb-1">School ID</label>
              <div class="font-mono-data text-mono-data text-primary"><%= schoolId %></div>
            </div>
            <div class="md:col-span-2 p-4 bg-surface-container-low rounded-lg border border-outline-variant/30">
              <label class="font-label-md text-label-md text-slate-muted block mb-1">Institution</label>
              <div class="font-body-md text-body-md text-primary font-semibold"><%= institutionName || 'Unknown institution' %></div>
            </div>
          </div>
        </div>

        <% if (error) { %>
          <div class="px-4 py-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm"><%= error %></div>
        <% } %>

        <form action="/register" class="flex flex-col gap-6" id="completeForm" method="POST">
          <input name="verificationToken" type="hidden" value="<%= token %>" />

          <div class="flex flex-col gap-2">
            <label class="font-label-md text-label-md text-on-surface" for="country">Country of Residence</label>
            <input autocomplete="country-name" class="w-full h-12 px-4 rounded-lg bg-white border border-outline-variant text-on-surface font-body-md focus:border-primary transition-all" id="country" minlength="2" name="country" placeholder="e.g. Rwanda" required type="text" />
            <p class="font-body-sm text-body-sm text-on-surface-variant">Used for regional fee calculations and regulatory compliance.</p>
          </div>

          <div class="flex flex-col gap-2">
            <label class="font-label-md text-label-md text-on-surface" for="password">Secure Password</label>
            <div class="relative">
              <input autocomplete="new-password" class="w-full h-12 px-4 pr-12 rounded-lg bg-white border border-outline-variant text-on-surface font-body-md focus:border-primary transition-all" id="password" minlength="8" name="password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" required type="password" />
              <button class="absolute right-4 top-3 text-outline hover:text-primary transition-colors" id="togglePassword" type="button">
                <span class="material-symbols-outlined">visibility</span>
              </button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
              <div class="flex items-center gap-2 text-slate-muted transition-colors" id="req-length">
                <span class="material-symbols-outlined text-[16px]">circle</span>
                <span class="font-body-sm text-body-sm">Minimum 8 characters</span>
              </div>
              <div class="flex items-center gap-2 text-slate-muted transition-colors" id="req-char">
                <span class="material-symbols-outlined text-[16px]">circle</span>
                <span class="font-body-sm text-body-sm">One special character (recommended)</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-4 mt-4">
            <button class="w-full h-14 bg-primary text-on-primary font-label-md text-lg rounded-xl shadow-lg hover:shadow-primary/20 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-3" id="submitBtn" type="submit">
              Create Account
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    (function () {
      var passwordInput = document.getElementById('password');
      var reqLength = document.getElementById('req-length');
      var reqChar = document.getElementById('req-char');

      function setState(el, met) {
        el.classList.toggle('text-slate-muted', !met);
        el.classList.toggle('text-status-completed', met);
        el.querySelector('span').textContent = met ? 'check_circle' : 'circle';
      }

      passwordInput.addEventListener('input', function (e) {
        var val = e.target.value;
        setState(reqLength, val.length >= 8);
        setState(reqChar, /[!@#$%^&*(),.?":{}|<>]/.test(val));
      });

      document.getElementById('togglePassword').addEventListener('click', function () {
        var isPass = passwordInput.type === 'password';
        passwordInput.type = isPass ? 'text' : 'password';
        this.innerHTML = '<span class="material-symbols-outlined">' + (isPass ? 'visibility_off' : 'visibility') + '</span>';
      });

      document.getElementById('completeForm').addEventListener('submit', function () {
        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Creating account&hellip;';
      });
    })();
  </script>
</body>
</html>
