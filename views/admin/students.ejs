<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All students - EduPay</title>
  <%- include('../partials/head') %>
</head>
<body class="bg-surface font-body-md text-on-surface flex flex-col min-h-screen">
  <%- include('../partials/nav', { user }) %>

  <main class="flex-grow w-full max-w-container-max mx-auto px-gutter py-8">
    <h1 class="font-headline-lg text-headline-lg text-primary mb-6">All students</h1>

    <div class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden">
      <% if (students.length === 0) { %>
        <p class="p-8 text-center font-body-md text-body-md text-slate-muted">No students registered yet.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container-low border-b border-outline-variant">
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">Country</th>
                <th class="px-6 py-3 font-label-md text-label-md text-slate-muted uppercase tracking-wider">KYC status</th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
              <% students.forEach(function (s) { %>
                <tr class="hover:bg-surface-container-low transition-colors">
                  <td class="px-6 py-4 font-body-md text-body-md font-semibold text-on-surface"><%= s.name %></td>
                  <td class="px-6 py-4 font-body-sm text-body-sm text-slate-muted"><%= s.email %></td>
                  <td class="px-6 py-4 font-body-sm text-body-sm text-slate-muted"><%= s.country %></td>
                  <td class="px-6 py-4"><% if (s.kycStatus) { %><%- include('../partials/badge', { status: s.kycStatus }) %><% } else { %><span class="font-body-sm text-body-sm text-slate-muted">Not submitted</span><% } %></td>
                  <td class="px-6 py-4 text-right"><a class="text-primary hover:underline font-label-md text-label-md" href="/admin/students/<%= s.id %>">View &rarr;</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <%- include('../partials/pagination', { meta, baseUrl: '/admin/students?' }) %>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
