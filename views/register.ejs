<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Verification | EduPay</title>
  <%- include('partials/head') %>
</head>
<body class="bg-background font-body-md text-on-surface min-h-screen flex flex-col">
  <header class="sticky top-0 z-50 flex justify-between items-center w-full px-gutter h-16 max-w-container-max mx-auto bg-surface-container-lowest shadow-sm">
    <a class="flex items-center gap-2" href="/">
      <span class="text-headline-md font-headline-md font-bold text-primary">EduPay</span>
    </a>
    <nav class="hidden md:flex gap-8 items-center">
      <a class="text-on-surface-variant font-label-md text-label-md hover:text-primary transition-colors" href="/login">Already have an account?</a>
    </nav>
  </header>

  <main class="flex-grow flex items-center justify-center py-12 px-gutter relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary opacity-5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-12 -left-24 w-80 h-80 bg-secondary opacity-5 rounded-full blur-3xl"></div>

    <div class="w-full max-w-4xl grid md:grid-cols-2 gap-8 items-start relative z-10">
      <!-- Left Side: Context & Info -->
      <div class="flex flex-col gap-8 md:pr-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed mb-4">
            <span class="material-symbols-outlined text-sm">verified_user</span>
            <span class="font-label-md text-label-md uppercase tracking-wider">Step 1 of 2</span>
          </div>
          <h1 class="font-headline-lg text-headline-lg text-primary mb-4">Secure Student Identity Verification</h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
            Institution admin and platform admin accounts are provisioned by EduPay staff, not
            self-registered here. To register as a student, we first confirm your institution
            already has a record for you - you'll set a password on the next step.
          </p>
        </div>
        <div class="space-y-6">
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">security</span>
            </div>
            <div>
              <h3 class="font-headline-md text-body-lg font-bold text-primary">Matched Against Your Institution</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Your name and school ID must match the record your institution already has on file for you.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">bolt</span>
            </div>
            <div>
              <h3 class="font-headline-md text-body-lg font-bold text-primary">Instant Validation</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Verification is checked in real time against your institution's records.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Side: Registration Form -->
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-lg p-8 md:p-10">
        <div class="mb-8">
          <h2 class="font-headline-md text-headline-md text-primary mb-2">Registration Details</h2>
          <div class="w-full bg-surface-variant h-1.5 rounded-full overflow-hidden">
            <div class="bg-primary h-full w-1/2 transition-all duration-700 ease-out"></div>
          </div>
          <div class="flex justify-between mt-2">
            <span class="font-label-md text-label-md text-primary">Identity</span>
            <span class="font-label-md text-label-md text-on-surface-variant opacity-50">KYC Setup</span>
          </div>
        </div>

        <% if (error) { %>
          <div class="mb-5 px-4 py-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm"><%= error %></div>
        <% } %>

        <form action="/register/verify" class="space-y-5" id="verificationForm" method="POST">
          <div class="space-y-2">
            <label class="font-label-md text-label-md text-on-surface" for="name">Full Name</label>
            <input autocomplete="name" class="w-full h-12 px-4 bg-surface-bright border border-outline-variant rounded-lg focus:border-primary transition-all font-body-md text-body-md" id="name" minlength="2" name="name" placeholder="As shown on your institution's records" required type="text" />
          </div>
          <div class="space-y-2">
            <label class="font-label-md text-label-md text-on-surface" for="email">Institutional Email Address</label>
            <input autocomplete="email" class="w-full h-12 px-4 bg-surface-bright border border-outline-variant rounded-lg focus:border-primary transition-all font-body-md text-body-md" id="email" name="email" placeholder="name@university.edu" required type="email" />
          </div>
          <div class="space-y-2">
            <label class="font-label-md text-label-md text-on-surface" for="institution">Educational Institution</label>
            <input class="w-full h-12 px-4 bg-surface-bright border border-outline-variant rounded-lg focus:border-primary transition-all font-body-md text-body-md" id="institution" minlength="2" name="institution" placeholder="e.g. EduPay Demo University" required type="text" />
          </div>
          <div class="space-y-2">
            <label class="font-label-md text-label-md text-on-surface" for="schoolId">School ID Number</label>
            <input class="w-full h-12 px-4 bg-surface-bright border border-outline-variant rounded-lg focus:border-primary transition-all font-mono-data text-mono-data" id="schoolId" name="schoolId" placeholder="e.g. STU-1001" required type="text" />
            <p class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1">
              <span class="material-symbols-outlined text-xs">info</span>
              Used for internal verification only
            </p>
          </div>
          <div class="pt-4">
            <button class="w-full h-14 bg-primary text-on-primary font-headline-md text-body-lg rounded-xl hover:bg-opacity-90 active:scale-[0.98] transition-all flex items-center justify-center gap-2 group" id="submitBtn" type="submit">
              <span>Verify My Details</span>
              <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </button>
          </div>
        </form>

        <p class="mt-6 text-center font-body-sm text-body-sm text-on-surface-variant">
          Already have an account? <a class="text-primary font-semibold hover:underline" href="/login">Log in</a>
        </p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    (function () {
      var form = document.getElementById('verificationForm');
      form.addEventListener('submit', function () {
        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Verifying&hellip;';
      });

      document.querySelectorAll('#verificationForm input').forEach(function (input) {
        input.addEventListener('focus', function () {
          input.parentElement.querySelector('label').classList.add('text-primary');
        });
        input.addEventListener('blur', function () {
          input.parentElement.querySelector('label').classList.remove('text-primary');
        });
      });
    })();
  </script>
</body>
</html>
