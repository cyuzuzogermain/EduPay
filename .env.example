# ==============================
# App
# ==============================
# Port the NestJS HTTP server listens on
PORT=3000
# Node environment: development | test | production
NODE_ENV=development

# ==============================
# Database (PostgreSQL via Prisma)
# ==============================
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://edupay:edupay1234@localhost:5432/edupay?schema=public"

# ==============================
# File uploads
# ==============================
# Local filesystem directory KYC document uploads are stored in - never served statically, only
# through the guarded GET /kyc/:documentId/file route
UPLOADS_DIR="./uploads/kyc"

# ==============================
# Auth (JWT)
# ==============================
# Secret used to sign access tokens - use a long, random value in production
JWT_SECRET="change-me-to-a-long-random-secret"
# Access token expiry, e.g. 15m, 1h
JWT_EXPIRES_IN="15m"
# Secret used to sign refresh tokens - MUST differ from JWT_SECRET
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-secret"
# Refresh token expiry, e.g. 7d, 30d
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================
# Email (SendGrid)
# ==============================
# API key generated in the SendGrid dashboard
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxx"
# Verified sender address used as the "From" for transactional emails
SENDGRID_FROM_EMAIL="no-reply@edupay.example"

# ==============================
# MTN MoMo (Sandbox) - payment partner credentials
# ==============================
# Ocp-Apim-Subscription-Key issued when subscribing to a MoMo product on the MTN developer portal
MOMO_SUBSCRIPTION_KEY="your-momo-subscription-key"
# API user UUID created against the MoMo sandbox
MOMO_API_USER="your-momo-api-user-uuid"
# API key generated for the above API user
MOMO_API_KEY="your-momo-api-key"
# MoMo target environment header value, e.g. sandbox
MOMO_TARGET_ENVIRONMENT="sandbox"
# Base URL for the MoMo API (sandbox vs production)
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
